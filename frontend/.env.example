# Copiar a .env para usar otra API (por ejemplo la local: http://127.0.0.1:8000).
# Sin .env se usa la API publicada en Azure.
VITE_API_URL=https://beautymatch-api.happyrock-538a1151.brazilsouth.azurecontainerapps.io
# Sommelier (agente de IA). Sin esta variable: en desarrollo se usa el local en el puerto 8001;
# en la versión publicada (npm run build) la página muestra "Disponible pronto".
VITE_SOMMELIER_URL=http://localhost:8001
