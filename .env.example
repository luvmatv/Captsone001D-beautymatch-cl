# Copy to .env (not committed) and fill in. Used by:
#   uvicorn src.api.main:app --env-file .env
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=beautymatch
# Optional: maximum connections in the API pool (default 10)
API_POOL_MAX_SIZE=10
# Browser origins allowed to call the API (CORS), comma-separated, exactly as
# the browser sends them: scheme + host + port, no path. Empty = none.
# http://localhost:5173 is the Vite dev server.
API_CORS_ORIGINS=http://localhost:5173
