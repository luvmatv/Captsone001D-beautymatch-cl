# Copy to .env (not committed) and fill in. Used by:
#   uvicorn src.api.main:app --env-file .env
#   the daily run, the loader, the pipeline and the embeddings (DATABASE_URL), read
#   from the .env of the folder they run in (src/db_config.py).

# The database the daily run writes to. Unset = the local Docker one
# (postgresql://postgres:dev@localhost:5432/beautymatch). For Neon, the DIRECT
# connection string (no "-pooler" in the host): the writer lock needs its own session.
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>.sa-east-1.aws.neon.tech/beautymatch?sslmode=require

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=beautymatch
# Optional: maximum connections in the API pool (default 10)
API_POOL_MAX_SIZE=10
# Browser origins allowed to call the API (CORS), comma-separated, exactly as
# the browser sends them: scheme + host + port, no path. Empty = none.
# http://localhost:5173 is the Vite dev server.
API_CORS_ORIGINS=http://localhost:5173
