# Imagen del sommelier (ver docs/sommelier.md). No incluye base de datos ni modelo de embeddings.
#
#   docker build -f Dockerfile.sommelier -t beautymatch-sommelier .
#   docker run -p 3000:3000 -e GEMINI_API_KEY=... -e CATALOG_API_URL=http://<api>:8000 beautymatch-sommelier
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN useradd --create-home --uid 1000 app
WORKDIR /app

COPY requirements-sommelier.txt .
RUN pip install -r requirements-sommelier.txt

COPY src/__init__.py ./src/__init__.py
COPY src/sommelier ./src/sommelier
USER app
EXPOSE 3000
CMD ["uvicorn", "src.sommelier.main:app", "--host", "0.0.0.0", "--port", "3000", "--proxy-headers", "--forwarded-allow-ips", "*"]
